# ===== Servidor =====
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ===== Base de datos =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pqrs_system
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# ===== JWT (reemplaza por una clave local larga y privada) =====
JWT_SECRET=replace_this_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h

# ===== Swagger =====
SWAGGER_SERVER_URL=http://localhost:3000
